    <!-- 6-Stage Approach & Engagement Flow -->
    <section id="approach">
        <div class="section-header">
            <h2>Our 6-Stage Development Approach</h2>
            <p>Connecting listening and analysis with design, execution, learning, and wider adoption.</p>
            <div class="divider"></div>
        </div>

        <div class="approach-steps">
            <div class="step-card">
                <span class="step-num">1</span>
                <h4>LISTEN</h4>
                <p>Understand communities, institutions and stakeholders.</p>
            </div>
            <div class="step-card">
                <span class="step-num">2</span>
                <h4>ANALYSE</h4>
                <p>Identify needs, gaps, opportunities and evidence.</p>
            </div>
            <div class="step-card">
                <span class="step-num">3</span>
                <h4>DESIGN</h4>
                <p>Develop practical and context-sensitive solutions.</p>
            </div>
            <div class="step-card">
                <span class="step-num">4</span>
                <h4>IMPLEMENT</h4>
                <p>Support effective field and institutional execution.</p>
            </div>
            <div class="step-card">
                <span class="step-num">5</span>
                <h4>LEARN</h4>
                <p>Capture experience, evidence and key lessons.</p>
            </div>
            <div class="step-card">
                <span class="step-num">6</span>
                <h4>SCALE</h4>
                <p>Strengthen successful models for wider adoption.</p>
            </div>
        </div>

        <div class="card-box" style="margin-top:30px;">
            <h3>📋 Standard 6-Step Client Engagement Flow</h3>
            <p style="font-size:14px;"><strong>1. Initial Discussion</strong> (Understand context & intended outcomes) → <strong>2. Scope Definition</strong> (Objectives, deliverables & timeline) → <strong>3. Proposal / Work Plan</strong> (Technical & financial proposal) → <strong>4. Delivery</strong> (Research, consultancy, training or documentation) → <strong>5. Review & Quality Assurance</strong> (Validation & feedback incorporation) → <strong>6. Handover & Learning</strong> (Final outputs & recommendations).</p>
        </div>
    </section>

    <!-- Who We Work With -->
    <section id="clients" style="background: #eaf2ee;">
        <div class="section-header">
            <h2>Who We Work With</h2>
            <p>Partnering with institutions across the development and social-impact ecosystem.</p>
            <div class="divider"></div>
        </div>

