    <!-- About, Vision, Mission & Values -->
    <section id="about">
        <div class="section-header">
            <h2>About Sustaina Solutions LLP</h2>
            <p>Translating development ideas into practical, context-sensitive and measurable solutions while keeping people, institutions, evidence and learning at the centre.</p>
            <div class="divider"></div>
        </div>

        <div class="grid-3">
            <div class="card-box">
                <h3>🌍 Who We Are</h3>
                <p style="font-size:14px;"><strong>Sustaina Solutions LLP</strong> is a development and social impact consultancy providing professional support across social development, poverty reduction, livelihoods, gender & social inclusion, local governance, community mobilisation, project planning, research, training, IEC campaigns, and knowledge management.</p>
            </div>
            <div class="card-box">
                <h3>🎯 Our Vision & Commitment</h3>
                <p style="font-size:14px;"><strong>Vision:</strong> To contribute to a more inclusive, equitable and sustainable society by strengthening people, institutions and development initiatives.</p>
                <p style="font-size:14px; margin-top:8px;"><strong>Commitment:</strong> Context-sensitive consulting rather than generic templates, treating communities as active agents of development.</p>
            </div>
            <div class="card-box">
                <h3>🚀 Our Mission</h3>
                <ul>
                    <li>Strengthen community-led development & local capacities</li>
                    <li>Support effective programme design & implementation</li>
                    <li>Promote gender equality, equity & social inclusion</li>
                    <li>Strengthen livelihoods & local economic opportunities</li>
                    <li>Generate, document & communicate development knowledge</li>
                    <li>Develop monitoring frameworks for measurable social impact</li>
                </ul>
            </div>
        </div>

        <!-- 7 Core Values -->
        <div class="values-grid">
            <div class="value-card">
                <h4>1. People-Centred</h4>
                <p>Development begins with understanding people, their aspirations and lived realities.</p>
            </div>
            <div class="value-card">
                <h4>2. Inclusion</h4>
                <p>Reaching people traditionally excluded from opportunities and decision-making.</p>
            </div>
            <div class="value-card">
                <h4>3. Participation</h4>
                <p>Communities are not merely beneficiaries; they are partners and active agents.</p>
            </div>
            <div class="value-card">
                <h4>4. Sustainability</h4>
                <p>Creating long-term social, institutional, economic and environmental value.</p>
            </div>
            <div class="value-card">
                <h4>5. Evidence</h4>
                <p>Planning and decisions informed by rigorous evidence, experience and learning.</p>
            </div>
            <div class="value-card">
                <h4>6. Integrity</h4>
                <p>Grounded in transparency, accountability and high ethical standards.</p>
            </div>
            <div class="value-card">
                <h4>7. Innovation</h4>
                <p>Leveraging digital tools and responsible AI to strengthen development practice.</p>
            </div>
        </div>
    </section>

    <!-- 10 Service Areas -->
    <section id="services" style="background: #eaf2ee;">
        <div class="section-header">
            <h2>What We Do: 10 Interconnected Service Areas</h2>
            <p>Available as focused technical assignments or integrated end-to-end support packages across the project lifecycle.</p>
            <div class="divider"></div>
        </div>

        <div class="services-grid">
            <div class="service-card">
                <div>
                    <span class="service-num">Service Area 4.1</span>
